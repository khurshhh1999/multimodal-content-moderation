# Copy to .env for local docker-compose
DATABASE_URL=postgresql://moderation:moderation@localhost:5432/moderation
REDIS_URL=redis://localhost:6379/0

# Storage / queue providers (local defaults: MinIO + LocalStack SQS)
STORAGE_PROVIDER=s3
QUEUE_PROVIDER=sqs

S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=moderation-content
S3_REGION=us-east-1

# GCP path (when STORAGE_PROVIDER=gcs / QUEUE_PROVIDER=pubsub / VISION_PROVIDER=gcp)
# GCP_PROJECT=your-gcp-project
# GCS_BUCKET=moderation-content
# PUBSUB_TOPIC=moderation-jobs
# PUBSUB_SUBSCRIPTION=moderation-jobs-sub
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

SQS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/moderation-jobs
SQS_DLQ_URL=http://localhost:4566/000000000000/moderation-jobs-dlq
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

VISION_PROVIDER=local
LLM_PROVIDER=rules
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

POLICY_VERSION=policy-v1
PIPELINE_VERSION=pipeline-v1
# Confidence routing bands (bump POLICY_VERSION when changing these)
AUTO_ALLOW=0.85
AUTO_BLOCK=0.90
NSFW_BLOCK=0.85
NSFW_FLAG=0.45
VIOLENCE_BLOCK=0.80
VIOLENCE_FLAG=0.40
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:5173
